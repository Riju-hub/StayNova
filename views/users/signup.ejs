<% layout("layouts/boilerplate") %>

<style>
  .auth-wrapper {
    min-height: calc(82vh - var(--nav-h-desktop, 74px));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1rem;
  }

  .auth-card {
    width: 100%;
    max-width: 460px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 20px;
    padding: 2.25rem 2rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .auth-header .auth-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #fff0f2;
    color: #ff385c;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin-bottom: 12px;
  }

  .auth-header h3 {
    font-weight: 700;
    color: #1e1e1e;
    font-size: 1.5rem;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }

  .auth-header p {
    color: #717171;
    font-size: 14px;
    margin: 0;
  }

  .form-group-custom {
    margin-bottom: 1.1rem;
  }

  .form-group-custom label {
    font-size: 12.5px;
    font-weight: 600;
    color: #484848;
    margin-bottom: 6px;
    display: block;
  }

  .form-group-custom .form-control {
    height: 48px;
    border-radius: 12px;
    border: 1.5px solid #e0e0e0;
    padding: 0.65rem 1rem;
    font-size: 14px;
    background-color: #fafafa;
    transition: all 0.2s ease;
  }

  .form-group-custom .form-control:focus {
    background-color: #ffffff;
    border-color: #ff385c;
    box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.12);
    outline: none;
  }

  .form-group-custom .valid-feedback {
    font-size: 12px;
    color: #27ae60;
    margin-top: 4px;
  }

  .form-group-custom .invalid-feedback {
    font-size: 12px;
    color: #ff385c;
    margin-top: 4px;
  }

  .btn-auth-submit {
    width: 100%;
    height: 48px;
    background: linear-gradient(135deg, #ff385c 0%, #e00b41 100%);
    border: none;
    border-radius: 12px;
    color: #ffffff;
    font-weight: 600;
    font-size: 15px;
    margin-top: 0.75rem;
    box-shadow: 0 4px 14px rgba(255, 56, 92, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-auth-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(255, 56, 92, 0.35);
  }

  .btn-auth-submit:active {
    transform: scale(0.99);
  }

  .auth-footer {
    text-align: center;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #f0f0f0;
    font-size: 13.5px;
    color: #717171;
  }

  .auth-footer a {
    color: #ff385c;
    font-weight: 600;
    text-decoration: none;
  }

  .auth-footer a:hover {
    text-decoration: underline;
  }
</style>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-icon">
        <i class="fa-solid fa-user-plus"></i>
      </div>
      <h3>Create an account</h3>
      <p>Join StayNova to explore and list unique stays</p>
    </div>

    <form action="/signup" method="post" class="needs-validation" novalidate>
      <div class="form-group-custom">
        <label for="username">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          placeholder="Choose a username" 
          class="form-control" 
          required 
          autocomplete="username"
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please choose a username.</div>
      </div>

      <div class="form-group-custom">
        <label for="email">Email address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="name@example.com" 
          class="form-control" 
          required 
          autocomplete="email"
        />
        <div class="invalid-feedback">Please enter a valid email address.</div>
      </div>

      <div class="form-group-custom">
        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="Create a strong password" 
          class="form-control" 
          required 
          autocomplete="new-password"
        />
        <div class="invalid-feedback">Please provide a password.</div>
      </div>

      <button type="submit" class="btn btn-auth-submit">Sign Up</button>
    </form>

    <div class="auth-footer">
      Already have an account? <a href="/login">Log in</a>
    </div>
  </div>
</div>