<% layout("layouts/boilerplate") %>

<style>
  /* -------------------------------------------------------------
     HIGH-SPECIFICITY ISOLATION SCOPE
     Overrides Bootstrap & external global CSS
  -------------------------------------------------------------- */
  #stay-show-scope {
    max-width: 1140px;
    margin: 6.5rem auto 5rem !important; /* Clears 5rem fixed navbar */
    padding: 0 1.25rem;
    color: #111827 !important;
  }

  /* Headings & Main Info */
  #stay-show-scope h1.stay-title {
    font-size: 2.2rem !important;
    font-weight: 800 !important;
    color: #111827 !important;
    line-height: 1.25 !important;
    margin-bottom: 0.5rem !important;
  }

  #stay-show-scope .stay-sub-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #374151 !important;
  }

  #stay-show-scope .stay-location-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 800 !important;
    color: #111827 !important;
  }
  #stay-show-scope .stay-location-badge i {
    color: #ff385c !important;
  }

  #stay-show-scope .host-header-mention {
    color: #374151 !important;
    font-weight: 600 !important;
  }
  #stay-show-scope .host-header-mention strong {
    color: #ff385c !important;
    font-weight: 800 !important;
  }

  /* Media Preview */
  #stay-show-scope .hero-wrapper {
    position: relative;
    width: 100%;
    height: 480px;
    border-radius: 28px;
    overflow: hidden;
    background: #e5e7eb;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
  }
  #stay-show-scope .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #stay-show-scope .hero-tag-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: #0f172a !important;
    color: #ffffff !important;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  #stay-show-scope .hero-tag-badge i {
    color: #ff385c !important;
  }

  /* Layout Grid */
  #stay-show-scope .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
    align-items: start;
  }
  @media (min-width: 992px) {
    #stay-show-scope .detail-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 2.75rem;
    }
  }

  /* Host Details */
  #stay-show-scope .host-badge-card {
    display: flex;
    align-items: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
  }
  #stay-show-scope .host-avatar {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff385c 0%, #e00b41 100%);
    color: #ffffff !important;
    font-weight: 900;
    font-size: 22px;
    display: grid;
    place-items: center;
    box-shadow: 0 4px 14px rgba(255, 56, 92, 0.3);
  }
  #stay-show-scope .host-name {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    color: #111827 !important;
  }
  #stay-show-scope .host-sub {
    font-size: 14px !important;
    font-weight: 600 !important;
    color: #4b5563 !important;
  }

  #stay-show-scope .stay-desc-body {
    padding-top: 1.5rem;
  }
  #stay-show-scope .stay-desc-body h5 {
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #111827 !important;
    margin-bottom: 0.85rem !important;
  }
  #stay-show-scope .stay-desc-text {
    font-size: 16px !important;
    line-height: 1.8 !important;
    color: #374151 !important;
    font-weight: 600 !important;
    white-space: pre-line;
  }

  /* Booking Card */
  #stay-show-scope .booking-card {
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 6.5rem;
  }
  #stay-show-scope .price-val {
    font-size: 2.1rem !important;
    font-weight: 900 !important;
    color: #ff385c !important;
  }
  #stay-show-scope .price-unit {
    color: #4b5563 !important;
    font-size: 15px !important;
    font-weight: 700 !important;
  }
  #stay-show-scope .tax-pill {
    font-size: 12.5px !important;
    color: #be123c !important;
    background: #ffe4e6 !important;
    padding: 4px 10px;
    border-radius: 6px;
    font-weight: 800 !important;
  }
  #stay-show-scope .card-perk-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14.5px !important;
    color: #111827 !important;
    font-weight: 700 !important;
    margin-bottom: 12px;
  }
  #stay-show-scope .card-perk-item i.green-icon {
    color: #16a34a !important;
    font-size: 17px;
  }
  #stay-show-scope .card-perk-item i.pink-icon {
    color: #ff385c !important;
    font-size: 17px;
  }

  /* Action Buttons */
  #stay-show-scope .owner-action-strip {
    display: flex;
    gap: 12px;
    margin-top: 1.5rem;
  }
  #stay-show-scope .btn-owner-edit {
    flex: 1;
    background: #f1f5f9 !important;
    color: #111827 !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 12px;
    padding: 11px;
    font-weight: 800 !important;
    text-align: center;
    text-decoration: none;
  }
  #stay-show-scope .btn-owner-del {
    background: #fee2e2 !important;
    color: #dc2626 !important;
    border: 1px solid #fca5a5 !important;
    border-radius: 12px;
    padding: 11px 20px;
    font-weight: 800 !important;
    cursor: pointer;
  }

  /* Reviews Overview */
  #stay-show-scope .premium-reviews-section {
    margin-top: 4.5rem;
    padding-top: 2.75rem;
    border-top: 2px solid #e2e8f0;
  }
  #stay-show-scope .review-score-hero {
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 24px;
    padding: 2.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    margin-bottom: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    #stay-show-scope .review-score-hero {
      grid-template-columns: 260px 1fr;
      align-items: center;
      gap: 3rem;
    }
  }

  #stay-show-scope .score-big-number {
    font-size: 3.75rem !important;
    font-weight: 900 !important;
    color: #ff385c !important;
    line-height: 1 !important;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  #stay-show-scope .score-big-number span {
    font-size: 1.4rem !important;
    color: #374151 !important;
    font-weight: 800 !important;
  }
  #stay-show-scope .score-caption {
    font-size: 14.5px !important;
    font-weight: 700 !important;
    color: #4b5563 !important;
    margin-top: 8px;
  }

  #stay-show-scope .breakdown-row {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 14px !important;
    font-weight: 800 !important;
    color: #111827 !important;
  }
  #stay-show-scope .breakdown-label {
    width: 55px;
    display: flex;
    align-items: center;
    gap: 5px;
    color: #111827 !important;
  }
  #stay-show-scope .breakdown-label i {
    color: #f59e0b !important;
  }
  #stay-show-scope .breakdown-track {
    flex: 1;
    height: 10px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }
  #stay-show-scope .breakdown-fill {
    height: 100%;
    background: linear-gradient(135deg, #ff385c 0%, #e00b41 100%);
    border-radius: 999px;
  }
  #stay-show-scope .breakdown-count {
    width: 36px;
    text-align: right;
    font-size: 13.5px !important;
    font-weight: 800 !important;
    color: #4b5563 !important;
  }

  /* Review Composer */
  #stay-show-scope .composer-wrapper {
    position: relative;
    border-radius: 24px;
    margin-bottom: 3rem;
  }
  #stay-show-scope .premium-composer {
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 24px;
    padding: 2.25rem;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
  }
  #stay-show-scope .composer-title {
    font-size: 1.35rem !important;
    font-weight: 900 !important;
    color: #111827 !important;
    margin: 0;
  }
  #stay-show-scope .form-label-bold {
    font-size: 14px !important;
    font-weight: 900 !important;
    color: #111827 !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 10px;
    display: block;
  }

  /* Interactive Multi-Color Stars */
  #stay-show-scope .rating-stars-container {
    display: inline-flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 14px;
    margin-bottom: 1rem;
    padding: 4px 0;
  }
  #stay-show-scope .rating-stars-container input[type="radio"] {
    display: none;
  }
  #stay-show-scope .rating-stars-container label {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 15px !important;
    font-weight: 800 !important;
    color: #94a3b8 !important;
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  #stay-show-scope .rating-stars-container label i {
    font-size: 20px;
  }
  #stay-show-scope .rating-stars-container label:hover,
  #stay-show-scope .rating-stars-container label:hover ~ label,
  #stay-show-scope .rating-stars-container input[type="radio"]:checked ~ label {
    color: #f59e0b !important;
    transform: scale(1.08);
  }

  #stay-show-scope .form-control-modern {
    width: 100%;
    border-radius: 16px;
    border: 2px solid #cbd5e1 !important;
    padding: 15px 18px;
    font-size: 15.5px !important;
    font-weight: 600 !important;
    color: #111827 !important;
    background: #ffffff !important;
    resize: vertical;
    min-height: 115px;
  }
  #stay-show-scope .form-control-modern::placeholder {
    color: #64748b !important;
    font-weight: 500 !important;
  }
  #stay-show-scope .form-control-modern:focus {
    border-color: #ff385c !important;
    outline: none;
    box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.15);
  }

  #stay-show-scope .btn-submit-premium {
    background: linear-gradient(135deg, #ff385c 0%, #e00b41 100%) !important;
    border: none !important;
    color: #ffffff !important;
    font-weight: 800 !important;
    font-size: 15px !important;
    border-radius: 12px;
    padding: 13px 32px;
    box-shadow: 0 4px 18px rgba(255, 56, 92, 0.35);
    cursor: pointer;
  }

  /* Guest Prompt Overlay */
  #stay-show-scope .guest-overlay-curtain {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(4px);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    padding: 1.5rem;
    text-align: center;
    border: 2px dashed #ff385c;
  }
  #stay-show-scope .guest-auth-prompt {
    background: #ffffff;
    padding: 2rem 2.5rem;
    border-radius: 22px;
    border: 1px solid #cbd5e1;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
    max-width: 440px;
  }
  #stay-show-scope .guest-auth-title {
    font-size: 1.25rem !important;
    font-weight: 900 !important;
    color: #111827 !important;
    margin-bottom: 6px;
  }
  #stay-show-scope .guest-auth-sub {
    font-size: 14.5px !important;
    color: #4b5563 !important;
    font-weight: 600 !important;
    line-height: 1.55;
    margin-bottom: 18px;
  }
  #stay-show-scope .btn-auth-login {
    display: inline-block;
    background: linear-gradient(135deg, #ff385c 0%, #e00b41 100%) !important;
    color: #ffffff !important;
    font-weight: 800 !important;
    padding: 11px 28px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14.5px;
    box-shadow: 0 4px 16px rgba(255, 56, 92, 0.35);
  }

  /* Review Cards */
  #stay-show-scope .review-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    #stay-show-scope .review-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }

  #stay-show-scope .luxury-review-card {
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 22px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }
  #stay-show-scope .user-badge-ring {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #ffe4e6 !important;
    color: #ff385c !important;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 18px;
  }
  #stay-show-scope .user-meta-name {
    font-weight: 800 !important;
    font-size: 16px !important;
    color: #111827 !important;
  }
  #stay-show-scope .user-verified-tag {
    font-size: 12.5px !important;
    color: #16a34a !important;
    font-weight: 700 !important;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  #stay-show-scope .card-quote-text {
    font-size: 15.5px !important;
    line-height: 1.7 !important;
    color: #374151 !important;
    font-weight: 600 !important;
    margin-bottom: 1.25rem;
  }
  #stay-show-scope .review-chip-rating {
    background: #fef3c7 !important;
    color: #b45309 !important;
    border-radius: 8px;
    padding: 4px 10px;
    font-weight: 800 !important;
    font-size: 13.5px !important;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  #stay-show-scope .review-chip-rating i {
    color: #f59e0b !important;
  }
  #stay-show-scope .review-footer-text {
    color: #64748b !important;
    font-size: 13px !important;
    font-weight: 700 !important;
  }
</style>

<div id="stay-show-scope">
  
  <!-- Listing Header -->
  <div class="stay-header">
    <h1 class="stay-title"><%= listing.title %></h1>
    <div class="stay-sub-bar">
      <div class="stay-location-badge">
        <i class="fa-solid fa-location-dot"></i>
        <span><%= listing.location %>, <%= listing.country %></span>
      </div>
      <div class="host-header-mention">
        <span>Hosted by <strong>@<%= listing.owner.username %></strong></span>
      </div>
    </div>
  </div>

  <!-- Hero Photo Banner -->
  <div class="hero-wrapper">
    <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="hero-img" />
    <% if(listing.category){ %>
      <div class="hero-tag-badge">
        <i class="fa-solid fa-tag"></i>
        <span><%= listing.category %></span>
      </div>
    <% } %>
  </div>

  <!-- Split Grid -->
  <div class="detail-grid">
    <div>
      <div class="host-badge-card">
        <div class="d-flex align-items-center gap-3">
          <div class="host-avatar">
            <%= listing.owner.username.charAt(0).toUpperCase() %>
          </div>
          <div>
            <div class="host-name">Hosted by <%= listing.owner.username %></div>
            <div class="host-sub"><%= listing.location %>, <%= listing.country %></div>
          </div>
        </div>
      </div>

      <div class="stay-desc-body">
        <h5>About this place</h5>
        <p class="stay-desc-text"><%= listing.description %></p>
      </div>

      <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
        <div class="owner-action-strip">
          <a href="/listings/<%= listing._id %>/edit" class="btn-owner-edit">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
          </a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" class="m-0">
            <button class="btn-owner-del">
              <i class="fa-solid fa-trash-can me-1"></i> Delete
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <div>
      <div class="booking-card">
        <div class="price-row d-flex align-items-baseline justify-content-between mb-3 pb-3 border-bottom">
          <div>
            <span class="price-val">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
            <span class="price-unit">/ night</span>
          </div>
          <span class="tax-pill">+ 18% GST</span>
        </div>

        <div class="mb-3">
          <div class="card-perk-item">
            <i class="fa-solid fa-circle-check green-icon"></i>
            <span>Verified stay with authentic guest reviews</span>
          </div>
          <div class="card-perk-item">
            <i class="fa-solid fa-bolt pink-icon"></i>
            <span>Instant booking confirmation available</span>
          </div>
          <div class="card-perk-item">
            <i class="fa-solid fa-wand-magic-sparkles pink-icon"></i>
            <span>Sanitized and quality-inspected space</span>
          </div>
        </div>

        <div class="p-3 bg-light rounded-3 text-center fw-bold small text-secondary" style="border: 1px solid #e5e7eb;">
          Reserve directly with host <span style="color: #ff385c;">@<%= listing.owner.username %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews & Rating Section -->
  <div class="premium-reviews-section">
    <%
      let totalRating = 0;
      let breakdown = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
      const revList = listing.reviews || [];
      const totalReviews = revList.length;

      revList.forEach(r => {
        const rate = Number(r.rating) || 5;
        totalRating += rate;
        if(breakdown[rate] !== undefined) {
          breakdown[rate]++;
        } else {
          breakdown[5]++;
        }
      });

      const avgRating = totalReviews > 0 ? (totalRating / totalReviews).toFixed(1) : "5.0";
    %>

    <!-- Performance & Stats Hero Banner -->
    <div class="review-score-hero">
      <div class="score-badge-panel">
        <div class="score-big-number">
          <%= avgRating %> <span>/ 5</span>
        </div>
        <div class="d-flex align-items-center gap-1 my-2" style="color: #f59e0b; font-size: 1.25rem;">
          <% for(let i = 1; i <= 5; i++) { %>
            <i class="fa-solid fa-star <%= i <= Math.round(Number(avgRating)) ? '' : 'text-black-50' %>"></i>
          <% } %>
        </div>
        <div class="score-caption">
          Based on <%= totalReviews %> guest <%= totalReviews === 1 ? 'review' : 'reviews' %>
        </div>
      </div>

      <!-- Rating Bar Breakdown -->
      <div class="d-flex flex-column gap-2">
        <% [5, 4, 3, 2, 1].forEach(star => { 
          const count = breakdown[star] || 0;
          const pct = totalReviews > 0 ? ((count / totalReviews) * 100).toFixed(0) : 0;
        %>
          <div class="breakdown-row">
            <div class="breakdown-label">
              <span><%= star %></span> <i class="fa-solid fa-star" style="font-size: 12px;"></i>
            </div>
            <div class="breakdown-track">
              <div class="breakdown-fill" style="width: <%= pct %>%"></div>
            </div>
            <div class="breakdown-count"><%= count %></div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Review Composer -->
    <div class="composer-wrapper">
      <% if(!currUser){ %>
        <div class="guest-overlay-curtain">
          <div class="guest-auth-prompt">
            <div class="mb-3">
              <i class="fa-solid fa-lock" style="font-size: 26px; color: #ff385c;"></i>
            </div>
            <h4 class="guest-auth-title">Log in to leave a review</h4>
            <p class="guest-auth-sub">Share your stay experience, tips, and thoughts with the StayNova community.</p>
            <a href="/login" class="btn-auth-login">
              <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Log In to Review
            </a>
          </div>
        </div>
      <% } %>

      <div class="premium-composer">
        <div class="d-flex align-items-center gap-2 mb-4">
          <i class="fa-solid fa-pen-nib" style="font-size: 20px; color: #ff385c;"></i>
          <h4 class="composer-title">Write a Review</h4>
        </div>

        <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
          <div class="mb-3">
            <label class="form-label-bold">Your Overall Rating</label>
            
            <div class="rating-stars-container">
              <input type="radio" id="rate5" name="review[rating]" value="5" checked <%= !currUser ? 'disabled' : '' %> />
              <label for="rate5" title="5 Stars">5 <i class="fa-solid fa-star"></i></label>

              <input type="radio" id="rate4" name="review[rating]" value="4" <%= !currUser ? 'disabled' : '' %> />
              <label for="rate4" title="4 Stars">4 <i class="fa-solid fa-star"></i></label>

              <input type="radio" id="rate3" name="review[rating]" value="3" <%= !currUser ? 'disabled' : '' %> />
              <label for="rate3" title="3 Stars">3 <i class="fa-solid fa-star"></i></label>

              <input type="radio" id="rate2" name="review[rating]" value="2" <%= !currUser ? 'disabled' : '' %> />
              <label for="rate2" title="2 Stars">2 <i class="fa-solid fa-star"></i></label>

              <input type="radio" id="rate1" name="review[rating]" value="1" <%= !currUser ? 'disabled' : '' %> />
              <label for="rate1" title="1 Star">1 <i class="fa-solid fa-star"></i></label>
            </div>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label-bold">Your Experience</label>
            <textarea 
              id="comment" 
              name="review[comment]" 
              rows="3" 
              class="form-control-modern" 
              placeholder="How was the ambiance, check-in, cleanliness, or hospitality? Share your honest feedback..." 
              required
              <%= !currUser ? 'disabled' : '' %>
            ></textarea>
            <div class="invalid-feedback">Please provide your review feedback.</div>
          </div>

          <button type="submit" class="btn-submit-premium" <%= !currUser ? 'disabled' : '' %>>Submit Feedback</button>
        </form>
      </div>
    </div>

    <!-- Review Cards Grid -->
    <% if(totalReviews > 0){ %>
      <div class="review-grid">
        <% for(let review of revList){ %>
          <div class="luxury-review-card">
            <div>
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-3">
                  <div class="user-badge-ring">
                    <%= review.author.username.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <div class="user-meta-name"><%= review.author.username %></div>
                    <div class="user-verified-tag">
                      <i class="fa-solid fa-circle-check"></i> Verified Guest
                    </div>
                  </div>
                </div>

                <div class="review-chip-rating">
                  <i class="fa-solid fa-star"></i> <%= review.rating %>.0
                </div>
              </div>

              <div class="mb-2" style="color: #f59e0b; font-size: 14px;">
                <% for(let i = 1; i <= 5; i++) { %>
                  <i class="fa-solid fa-star <%= i <= review.rating ? '' : 'text-black-50' %>"></i>
                <% } %>
              </div>

              <p class="card-quote-text">
                "<%= review.comment %>"
              </p>
            </div>

            <div class="d-flex align-items-center justify-content-between pt-3 border-top">
              <span class="review-footer-text">Stay experience review</span>

              <% if(currUser && review.author._id.equals(currUser._id)){ %>
                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" class="m-0">
                  <button class="btn btn-sm btn-outline-danger border-0" title="Delete your review">
                    <i class="fa-regular fa-trash-can"></i>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="text-center py-5 bg-white rounded-4 border border-2 border-dashed">
        <div class="mb-3">
          <i class="fa-regular fa-star fa-3x" style="color: #cbd5e1;"></i>
        </div>
        <h5 class="fw-bold" style="color: #111827;">No Reviews Yet</h5>
        <p class="mb-0" style="color: #64748b; font-size: 15px; font-weight: 600;">Be the very first guest to experience this stay and share your journey!</p>
      </div>
    <% } %>

  </div>

</div>