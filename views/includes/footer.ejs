<style>
  :root {
    --brand: #ff385c;
    --brand-dark: #e00b41;
    --brand-gradient: linear-gradient(135deg, #ff385c 0%, #e00b41 50%, #c10834 100%);
    --brand-glow: rgba(255, 56, 92, 0.32);
    --brand-soft: rgba(255, 56, 92, 0.08);
    --bg-dark-base: #0f1117;
    --bg-dark-surface: rgba(26, 29, 38, 0.7);
    --bg-dark-card: rgba(255, 255, 255, 0.035);
    --border-dark: rgba(255, 255, 255, 0.08);
    --border-dark-hover: rgba(255, 56, 92, 0.35);
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --spring-bounce: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Deep Mesh Gradient Floating Footer */
  .sn-footer {
    background-color: var(--bg-dark-base);
    background-image: 
      radial-gradient(at 10% 20%, rgba(255, 56, 92, 0.09) 0px, transparent 45%),
      radial-gradient(at 90% 90%, rgba(99, 102, 241, 0.07) 0px, transparent 40%);
    border-top: 1px solid var(--border-dark);
    color: var(--text-secondary);
    position: relative;
    padding-top: 4.5rem;
    padding-bottom: 2rem;
    overflow: hidden;
  }

  /* Newsletter Modern Card */
  .sn-newsletter-card {
    background: var(--bg-dark-surface);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border-dark);
    border-radius: 28px;
    padding: 2.25rem 2.5rem;
    margin-bottom: 4rem;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 992px) {
    .sn-newsletter-card {
      flex-direction: row;
      gap: 3rem;
    }
  }
  .sn-newsletter-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--brand-gradient);
  }

  .sn-newsletter-text h4 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }
  .sn-newsletter-text p {
    font-size: 14.5px;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Modern Capsule Input */
  .sn-input-group {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1.5px solid var(--border-dark);
    border-radius: 999px;
    padding: 4px 6px 4px 18px;
    width: 100%;
    max-width: 420px;
    transition: all 0.25s var(--spring-bounce);
  }
  .sn-input-group:focus-within {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--brand);
    box-shadow: 0 0 0 4px var(--brand-glow);
  }
  .sn-newsletter-input {
    border: none;
    outline: none;
    background: transparent;
    color: var(--text-primary);
    font-size: 14px;
    width: 100%;
  }
  .sn-newsletter-input::placeholder {
    color: #64748b;
  }
  .sn-newsletter-btn {
    background: var(--brand-gradient);
    border: none;
    border-radius: 999px;
    padding: 10px 22px;
    color: #fff;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px var(--brand-glow);
    transition: transform 0.2s var(--spring-bounce), box-shadow 0.2s ease;
    white-space: nowrap;
  }
  .sn-newsletter-btn:hover {
    transform: translateY(-1.5px) scale(1.02);
    box-shadow: 0 6px 18px var(--brand-glow);
  }
  .sn-newsletter-btn:active {
    transform: scale(0.96);
  }

  /* Footer Navigation Columns */
  .footer-col-title {
    font-size: 13.5px;
    font-weight: 750;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 1.25rem;
  }
  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .footer-link-item {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s var(--spring-bounce);
    width: fit-content;
  }
  .footer-link-item:hover {
    color: #ffffff;
    transform: translateX(4px);
  }
  .footer-link-item:hover i {
    color: var(--brand);
  }

  .nav-tag-pulse {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(255, 56, 92, 0.15);
    color: var(--brand);
    border: 1px solid rgba(255, 56, 92, 0.25);
  }

  /* Live Host Metric Badge */
  .host-stat-card {
    background: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    border-radius: 18px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 1.25rem;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 12px #10b981;
    animation: pulseGlow 2s infinite;
  }

  /* Bottom Bar */
  .sn-footer-divider {
    border-color: var(--border-dark);
    margin: 3.5rem 0 1.75rem;
  }
  .sn-footer-bottom {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .sn-footer-bottom {
      flex-direction: row;
    }
  }

  /* Brand Icon Emblem */
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: #ffffff !important;
    font-size: 1.25rem;
    font-weight: 850;
    letter-spacing: -0.03em;
  }
  .footer-brand i {
    color: var(--brand);
    font-size: 1.5rem;
    filter: drop-shadow(0 2px 8px var(--brand-glow));
  }

  /* Social Capsule Cluster */
  .sn-social-cluster {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .sn-social-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-dark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: all 0.25s var(--spring-bounce);
  }
  .sn-social-btn:hover {
    color: #ffffff;
    background: var(--brand-gradient);
    border-color: transparent;
    transform: translateY(-3px) scale(1.1);
    box-shadow: 0 6px 16px var(--brand-glow);
  }
  .sn-social-btn:active {
    transform: scale(0.92);
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.35); opacity: 0.6; }
  }
</style>

